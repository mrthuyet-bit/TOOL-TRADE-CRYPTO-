{
  "name": "meme-coin-radar",
  "private": true,
  "version": "1.0.0",
  "description": "Meme Coin Radar - Realtime Crypto Scanner Windows App",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "node electron/dev.cjs",
    "build:exe": "node scripts/build-exe.cjs"
  },
  "build": {
    "appId": "com.memecoin.radar",
    "productName": "Meme Coin Radar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
